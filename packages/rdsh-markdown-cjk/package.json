{
  "name": "rdsh-markdown-cjk",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "CJK-friendly links in the DSH Web markdown renderer: `**https://x**（memo）` and `https://x。` keep their link",
  "exports": {
    ".": "./index.js",
    "./markdown": "./markdown-cjk.js"
  },
  "files": [
    "index.js",
    "markdown-cjk.js",
    "cordis.patch.yml",
    "README.md",
    "docs/*.png"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "meta": {
    "title": "Markdown CJK",
    "description": "URL の直後に日本語が続いてもリンクが壊れないようにします。"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraneko1/dsh-extensions.git",
    "directory": "packages/rdsh-markdown-cjk"
  },
  "homepage": "https://github.com/kuraneko1/dsh-extensions/tree/main/packages/rdsh-markdown-cjk#readme",
  "bugs": {
    "url": "https://github.com/kuraneko1/dsh-extensions/issues"
  },
  "author": "kuraneko1"
}
