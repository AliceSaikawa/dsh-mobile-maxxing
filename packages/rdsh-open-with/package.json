{
  "name": "rdsh-open-with",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Right-click any file path or URL in the dsh web UI to open it in a new tab or in a desktop app (rdsh)",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "meta": {
    "title": "rdsh 右クリックで開く",
    "description": "トランスクリプトなどに表示されているファイルパスや URL を右クリックして、新しいタブ・デスクトップアプリ・親フォルダで開いたり、パスをコピーしたりできます。"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraneko1/dsh-extensions.git",
    "directory": "packages/rdsh-open-with"
  },
  "homepage": "https://github.com/kuraneko1/dsh-extensions/tree/main/packages/rdsh-open-with#readme",
  "bugs": {
    "url": "https://github.com/kuraneko1/dsh-extensions/issues"
  },
  "author": "kuraneko1"
}
